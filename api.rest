# REST Client requests for the Cybersec API (Strapi v4)
# Test values are read from the environment via {{$dotenv VARIABLE_NAME}}.
# ต้องมีไฟล์ .env อยู่ในโฟลเดอร์เดียวกับไฟล์นี้ (ดู .env.example เป็นแม่แบบ)

### =========================================================
### 1. ADMIN SECTION (Strapi Admin panel API)
### =========================================================

### 1.1 First Admin Signup
# รันแค่ "ครั้งเดียว" ตอนยังไม่มี admin คนไหนในระบบเลย
# หาว่ามี admin หรือยัง: เปิด {{$dotenv BASE_URL}}/admin ในเบราว์เซอร์
#   - ถ้าขึ้นฟอร์มสมัครสมาชิก (Welcome) = ยังไม่มี ใช้ request นี้ได้
#   - ถ้าขึ้นฟอร์ม login = มีแล้ว ข้ามไปข้อ 1.2 เลย
# @name firstAdminSignup
POST {{$dotenv BASE_URL}}/admin/register-admin
Content-Type: application/json

{
  "firstname": "{{$dotenv ADMIN_FIRST_NAME}}",
  "lastname": "{{$dotenv ADMIN_LAST_NAME}}",
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "password": "{{$dotenv ADMIN_PASSWORD}}"
}

### 1.2 Admin Login
# รันได้เรื่อยๆ หลังจากมี admin account แล้ว
# @name adminLogin
POST {{$dotenv BASE_URL}}/admin/login
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "password": "{{$dotenv ADMIN_PASSWORD}}",
  "rememberMe": true
}

### 1.3 Admin Profile (ต้องรัน 1.2 ก่อน)
# ถ้ารันแล้วได้ 401: เปิด response ของ 1.2 ดูว่า field token จริงๆ ชื่อ
# data.token หรือ data.accessToken แล้วแก้บรรทัดล่างให้ตรง
GET {{$dotenv BASE_URL}}/admin/users/me
Authorization: Bearer {{adminLogin.response.body.$.data.token}}
### 1.4 Admin Forgot Password (ข้ามได้ถ้ายังไม่ได้ตั้งค่า SMTP)
POST {{$dotenv BASE_URL}}/admin/forgot-password
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}"
}

### 1.5 Admin Reset Password (ต้องมี code จริงจากอีเมล ไม่ใช่ placeholder)
POST {{$dotenv BASE_URL}}/admin/reset-password
Content-Type: application/json

{
  "code": "{{$dotenv ADMIN_RESET_CODE}}",
  "password": "{{$dotenv ADMIN_PASSWORD}}",
  "passwordConfirmation": "{{$dotenv ADMIN_PASSWORD}}"
}


### =========================================================
### 2. USER SECTION (Users & Permissions plugin — Public API)
### =========================================================

### 2.1 User Signup
# รันแค่ "ครั้งเดียวต่อ 1 email/username" ซ้ำแล้วจะได้ 400
# @name userSignup
POST {{$dotenv BASE_URL}}/api/auth/local/register
Content-Type: application/json

{
  "username": "{{$dotenv USER_USERNAME}}",
  "email": "{{$dotenv USER_EMAIL}}",
  "password": "{{$dotenv USER_PASSWORD}}"
}

### 2.2 User Login
# @name userLogin
POST {{$dotenv BASE_URL}}/api/auth/local
Content-Type: application/json

{
  "identifier": "{{$dotenv USER_EMAIL}}",
  "password": "{{$dotenv USER_PASSWORD}}"
}

### 2.3 User Profile (ต้องรัน 2.2 ก่อน)
GET {{$dotenv BASE_URL}}/api/users/me
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 2.4 User Forgot Password (ข้ามได้ถ้ายังไม่ได้ตั้งค่า SMTP)
POST {{$dotenv BASE_URL}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{$dotenv USER_EMAIL}}"
}

### 2.5 User Reset Password (ต้องมี code จริงจากอีเมล ไม่ใช่ placeholder)
POST {{$dotenv BASE_URL}}/api/auth/reset-password
Content-Type: application/json

{
  "code": "{{$dotenv USER_RESET_CODE}}",
  "password": "{{$dotenv USER_PASSWORD}}",
  "passwordConfirmation": "{{$dotenv USER_PASSWORD}}"
}


### =========================================================
### 3. CONTENT SECTION (Student / Subject / Teacher)
### ก่อนใช้ Section นี้ได้ ต้องไปทำ 2 อย่างใน Admin Panel ก่อน:
###   1) Content-Type Builder -> สร้าง Collection Type ชื่อ Student, Subject, Teacher
###      พร้อม field ตามที่ใช้ด้านล่าง (name, mobile, cardId เป็นต้น)
###   2) Settings -> Users & Permissions -> Roles -> Authenticated
###      -> ติ๊กเปิด find, findOne, create, update ให้ทั้ง 3 content-type
### ไม่ทำ 2 ข้อนี้ก่อน จะได้ 404 (ยังไม่มี content-type) หรือ 403 (ยังไม่เปิดสิทธิ์)
### =========================================================

## --- 3.1 Student ---

### 3.1.1 Create Student
# @name studentCreate
POST {{$dotenv BASE_URL}}/api/students
Authorization: Bearer {{userLogin.response.body.$.jwt}}
Content-Type: application/json

{
  "data": {
    "name": "{{$dotenv STUDENT_NAME}}",
    "mobile": "{{$dotenv STUDENT_MOBILE}}",
    "cardId": "{{$dotenv STUDENT_CARD_ID}}"
  }
}

### 3.1.2 List All Students
GET {{$dotenv BASE_URL}}/api/students
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.1.3 Get One Student (ต้องรัน 3.1.1 ก่อน)
GET {{$dotenv BASE_URL}}/api/students/{{studentCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.1.4 Update Student (ต้องรัน 3.1.1 ก่อน)
PUT {{$dotenv BASE_URL}}/api/students/{{studentCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}
Content-Type: application/json

{
  "data": {
    "name": "{{$dotenv STUDENT_NAME_UPDATE}}"
  }
}

### 3.1.5 Delete Student 
DELETE {{$dotenv BASE_URL}}/api/students/{{studentCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}


