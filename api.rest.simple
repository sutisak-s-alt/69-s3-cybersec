```http
# REST Client requests for the Cybersec API (Strapi v4)
# Test values are read from the environment via {{$dotenv VARIABLE_NAME}}.
# Configure them in .env (see .env.simple as a template).

### =========================================================
### 1. ADMIN SECTION
### =========================================================

### 1.1 Admin Login
# @name adminLogin
POST {{$dotenv BASE_URL}}/admin/login
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "password": "{{$dotenv ADMIN_PASSWORD}}",
  "rememberMe": true
}

### 1.2 First Admin Signup
# Run only when no administrator has been created yet.
POST {{$dotenv BASE_URL}}/admin/register-admin
Content-Type: application/json

{
  "firstname": "{{$dotenv ADMIN_FIRST_NAME}}",
  "lastname": "{{$dotenv ADMIN_LAST_NAME}}",
  "email": "{{$dotenv ADMIN_EMAIL}}",
  "password": "{{$dotenv ADMIN_PASSWORD}}"
}

### 1.3 Admin Forgot Password
POST {{$dotenv BASE_URL}}/admin/forgot-password
Content-Type: application/json

{
  "email": "{{$dotenv ADMIN_EMAIL}}"
}

### 1.3.1 Admin Reset Password
POST {{$dotenv BASE_URL}}/admin/reset-password
Content-Type: application/json

{
  "code": "replace-with-reset-code",
  "password": "{{$dotenv ADMIN_PASSWORD}}",
  "passwordConfirmation": "{{$dotenv ADMIN_PASSWORD}}"
}

### 1.4 Admin Profile
# Send Admin Login first.
GET {{$dotenv BASE_URL}}/admin/users/me
Authorization: Bearer {{adminLogin.response.body.$.data.token}}


### =========================================================
### 2. USER SECTION
### =========================================================

### 2.1 User Login
# @name userLogin
POST {{$dotenv BASE_URL}}/api/auth/local
Content-Type: application/json

{
  "identifier": "{{$dotenv USER_EMAIL}}",
  "password": "{{$dotenv USER_PASSWORD}}"
}

### 2.2 User Signup
# @name userSignup
POST {{$dotenv BASE_URL}}/api/auth/local/register
Content-Type: application/json

{
  "username": "{{$dotenv USER_USERNAME}}",
  "email": "{{$dotenv USER_EMAIL}}",
  "password": "{{$dotenv USER_PASSWORD}}"
}

### 2.3 User Forgot Password
POST {{$dotenv BASE_URL}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{$dotenv USER_EMAIL}}"
}

### 2.3.1 User Reset Password
POST {{$dotenv BASE_URL}}/api/auth/reset-password
Content-Type: application/json

{
  "code": "replace-with-reset-code",
  "password": "{{$dotenv USER_PASSWORD}}",
  "passwordConfirmation": "{{$dotenv USER_PASSWORD}}"
}

### 2.4 User Profile
# Send User Login first.
GET {{$dotenv BASE_URL}}/api/users/me
Authorization: Bearer {{userLogin.response.body.$.jwt}}


### =========================================================
### 3. CONTENT SECTION
### =========================================================

## --- 3.1 Student ---

### 3.1.1 Create Student
# @name studentCreate
POST {{$dotenv BASE_URL}}/api/students
Authorization: Bearer {{userLogin.response.body.$.jwt}}
Content-Type: application/json

{
  "data": {
    "name": "{{$dotenv STUDENT_NAME}}",
    "mobile": "{{$dotenv STUDENT_MOBILE}}",
    "cardId": "{{$dotenv STUDENT_CARD_ID}}"
  }
}

### 3.1.2 List All Students
GET {{$dotenv BASE_URL}}/api/students
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.1.3 List Student with ID
GET {{$dotenv BASE_URL}}/api/students/{{studentCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.1.4 Update Student
PUT {{$dotenv BASE_URL}}/api/students/{{studentCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}
Content-Type: application/json

{
  "data": {
    "name": "{{$dotenv STUDENT_NAME_UPDATE}}"
  }
}


## --- 3.2 Subject ---

### 3.2.1 Create Subject
# @name subjectCreate
POST {{$dotenv BASE_URL}}/api/subjects
Authorization: Bearer {{userLogin.response.body.$.jwt}}
Content-Type: application/json

{
  "data": {
    "name": "{{$dotenv SUBJECT_NAME}}"
  }
}

### 3.2.2 List All Subjects
GET {{$dotenv BASE_URL}}/api/subjects
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.2.3 List Subject with ID
GET {{$dotenv BASE_URL}}/api/subjects/{{subjectCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.2.4 Update Subject
PUT {{$dotenv BASE_URL}}/api/subjects/{{subjectCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}
Content-Type: application/json

{
  "data": {
    "name": "{{$dotenv SUBJECT_NAME_UPDATE}}"
  }
}


## --- 3.3 Teacher ---

### 3.3.1 Create Teacher
# @name teacherCreate
POST {{$dotenv BASE_URL}}/api/teachers
Authorization: Bearer {{userLogin.response.body.$.jwt}}
Content-Type: application/json

{
  "data": {
    "name": "{{$dotenv TEACHER_NAME}}"
  }
}

### 3.3.2 List All Teachers
GET {{$dotenv BASE_URL}}/api/teachers
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.3.3 List Teacher with ID
GET {{$dotenv BASE_URL}}/api/teachers/{{teacherCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.3.4 Update Teacher
PUT {{$dotenv BASE_URL}}/api/teachers/{{teacherCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}
Content-Type: application/json

{
  "data": {
    "name": "{{$dotenv TEACHER_NAME_UPDATE}}"
  }
}
```
